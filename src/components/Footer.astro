---
/**
 * Footer — the single site footer.
 * CSS ships as an inline string (see styles/chrome.ts), token-optional.
 */
import site from "../site.config.json";
const year = new Date().getFullYear();

const cols = [
  { heading: "SpeechLive AI", links: [
    { label: "SpeechLive platform",   href: "/philips-speechlive" },
    { label: "Legal AI Assistant",    href: "/legal" },
    { label: "Professional AI",       href: "/professional" },
    { label: "Compare solutions",     href: "/comparison" },
  ]},
  { heading: "Speech-to-Text", links: [
    { label: "Dragon Professional 16",href: "/dragon-professional-16" },
    { label: "Dragon Medical One",    href: "/dragon-medical-one" },
    { label: "Dragon Anywhere (EOL)", href: "/dragon-professional-anywhere" },
    { label: "All Dragon software",   href: "/dragon-software" },
    { label: "SpeechRecognition.cloud",href: "/speech-recognition-cloud" },
    { label: "Speech to text software",href: "/speech-to-text" },
  ]},
  { heading: "Hardware & services", links: [
    { label: "Dictation equipment",   href: "/dictation-equipment" },
    { label: "Transcription services",href: "/transcription-services" },
    { label: "Medical transcription", href: "/medical-transcription" },
    { label: "Cloud speech solutions",href: "/cloud-speech-solutions" },
  ]},
  { heading: "Company", links: [
    { label: "Support",               href: "/support" },
    { label: "About",                 href: "/about" },
    { label: "News & guides",         href: "/news" },
    { label: "Privacy",               href: "/privacy" },
    { label: "Terms",                 href: "/terms" },
  ]},
];
import { footerCss } from "../styles/chrome";
---
<footer class="sf">
  <div class="sf-wrap">
    <div class="sf-grid">
      <div class="sf-brandcol">
        <div class="sf-brand">
          <img src="/logo.png" alt="Dictation Solutions Australia" width="180" height="38" class="sf-logo" />
        </div>
        <p class="sf-blurb">
          Australian dictation and speech recognition specialists.
          Official Philips SpeechLive partner.
        </p>
        <a href="tel:1300255900" class="sf-phone">1300 255 900</a>
      </div>

      {cols.map((c) => (
        <div>
          <h3>{c.heading}</h3>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="sf-legal">{site.branding?.footerDisclaimer}</p>
    <p class="sf-copy">&copy; {year} Dictation Solutions Australia — part of the Voice Recognition Australia network.</p>
  </div>
</footer>

<style is:inline set:html={footerCss}></style>
