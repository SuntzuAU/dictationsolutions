---
export interface Props {
  kicker: string; heading: string;
  cards: { title: string; body: string; icon?: string }[];
}
const { kicker, heading, cards } = Astro.props;
const fallback = `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>`;
---
<section class="sec-lg">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{kicker}</div>
      <h2>{heading}</h2>
    </div>
    <div class="cards-3">
      {cards.map((c) => (
        <article class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="var(--v-mid)" stroke-width="2" stroke-linecap="round"
                 set:html={c.icon ?? fallback} />
          </div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
