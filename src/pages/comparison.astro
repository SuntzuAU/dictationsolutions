---
import SiteNav from "../components/SiteNav.astro";
import Footer from "../components/Footer.astro";
import site from "../site.config.json";

const c = site.colours;
const primaryColour = c.primary || "#1f2937";
const canonicalUrl = site.domain + "/comparison";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Compare Dictation Solutions | {site.siteName}</title>
    <meta name="description" content="Compare Dragon, Philips SpeechLive, Speech Recognition Cloud, and hardware solutions side-by-side to find the right fit for your workflow." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Compare Dictation Solutions" />
    <meta property="og:description" content="Side-by-side comparison of speech recognition and dictation tools." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_AU" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&display=swap" />
    <style is:inline>
:root{--bg:#ffffff;--text:#12151A;--primary:#12151A;--accent:#12151A;--accentHover:#2A3038;--muted:#5A6473;--neutral:#F7F8FA;--line:#E5E8ED;--soft:#F7F8FA;--ink:#12151A;--ink-2:#2A3038;--v:#12151A;--v-mid:#2A3038;--v-tint:#F7F8FA;--v-tint-2:#E5E8ED;--font:Figtree,system-ui,-apple-system,'Segoe UI',sans-serif;--container:1180px;--gutter:44px}
      *,*::before,*::after{box-sizing:border-box}
      body{margin:0;font-family:var(--font);line-height:1.6;background:var(--bg);color:var(--text)}
      a{color:inherit;text-decoration:none}
      .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
      header{position:sticky;top:0;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid #e2e8f0;z-index:100}
      .nav{display:flex;align-items:center;justify-content:space-between;padding:10px 0;gap:16px}
      .logo img{height:40px;width:auto}
      .nav-links{display:flex;gap:18px;font-size:14px;font-weight:500;color:#334155;align-items:center}
      .nav-links a:hover{color:var(--accent)}
      .nav-ctas{display:flex;gap:10px;align-items:center}
      .btn{display:inline-block;padding:10px 20px;border-radius:8px;font-weight:700;font-size:14px;border:2px solid transparent;cursor:pointer;transition:all .15s;white-space:nowrap}
      .btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
      .btn-primary:hover{background:var(--accentHover);border-color:var(--accentHover)}
      .btn-secondary{background:transparent;border-color:var(--primary);color:var(--primary)}
      .btn-secondary:hover{background:var(--primary);color:#fff}
      .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:none;border:none}
      .hamburger span{display:block;width:22px;height:2px;background:#334155;border-radius:2px}
      .mobile-nav{display:none;padding:12px 0 8px;border-top:1px solid #e2e8f0}
      .mobile-nav a{display:block;padding:10px 0;font-size:15px;font-weight:500;color:#334155;border-bottom:1px solid #f1f5f9}
      section{padding:32px 0}
      .hero{padding:36px 0;text-align:center}
      .hero h1{font-size:32px;margin:0 0 12px;letter-spacing:-.038em}
      .hero p{font-size:15px;color:var(--muted);margin:0 0 20px;max-width:720px;line-height:1.7;margin-left:auto;margin-right:auto}
      /* ---- comparison table ---- */
      .ctable-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:22px;padding-bottom:4px}
      .compare-table{width:100%;min-width:940px;border-collapse:separate;border-spacing:0}
      .compare-table thead th{
        position:sticky;top:0;z-index:2;
        background:var(--ink);color:#fff;font-weight:700;font-size:11.5px;
        letter-spacing:.07em;text-transform:uppercase;
        padding:13px 16px;text-align:left;white-space:nowrap;vertical-align:middle;
      }
      .compare-table thead th:first-child{border-radius:10px 0 0 0}
      .compare-table thead th:last-child{border-radius:0 10px 0 0}
      .compare-table thead th.col-ai{background:linear-gradient(135deg,#A80DF1 0%,#1B3BC4 100%);color:#fff}
      .compare-table tbody td{
        padding:15px 16px;text-align:left;vertical-align:middle;
        border-bottom:1px solid var(--line);font-size:13px;color:var(--muted);
        background:#fff;transition:background .15s ease;
      }
      .compare-table tbody tr:last-child td{border-bottom:none}
      .compare-table tbody tr:hover td{background:#FBFCFE}
      .compare-table tbody tr:last-child td:first-child{border-radius:0 0 0 10px}
      .compare-table tbody tr:last-child td:last-child{border-radius:0 0 10px 0}

      /* product name cell — carries the vertical colour */
      .p-cell{position:relative;padding-left:22px !important}
      .p-cell::before{
        content:"";position:absolute;left:8px;top:50%;transform:translateY(-50%);
        width:4px;height:26px;border-radius:3px;background:var(--rc,var(--line));
      }
      .p-name{display:block;font-size:14px;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1.3}
      a.p-name{text-decoration:none}
      a.p-name:hover{color:var(--rc,var(--ink));text-decoration:underline}
      .p-badge{
        display:inline-block;margin-top:5px;font-size:9.5px;font-weight:800;
        letter-spacing:.1em;text-transform:uppercase;padding:3px 7px;border-radius:4px;
        background:var(--rc,var(--ink));color:#fff;
      }

      /* AI rows get a tinted band and a stronger presence */
      tr.row-ai td{background:var(--rt,#F7F8FA)}
      tr.row-ai:hover td{background:var(--rt2,#F1F3F7)}
      tr.row-ai td.ai-cell{font-weight:600;color:var(--ink-2)}

      /* SRC — the featured row. Outlined band, stronger than the AI tints. */
      tr.row-src td{
        background:#F0F6FF;
        border-top:2px solid #0B5ED7;border-bottom:2px solid #0B5ED7;
        color:var(--ink-2);
      }
      tr.row-src:hover td{background:#E4EEFE}
      tr.row-src td:first-child{border-left:2px solid #0B5ED7;border-radius:10px 0 0 10px}
      tr.row-src td:last-child{border-right:2px solid #0B5ED7;border-radius:0 10px 10px 0}
      tr.row-src .p-cell::before{width:5px;height:32px;box-shadow:0 0 0 3px rgba(11,94,215,.14)}
      tr.row-src .p-name{font-size:15px}
      tr.row-src .p-badge{background:#0B5ED7}
      tr.row-src .price-link{
        display:inline-block;background:#0B5ED7;color:#fff;padding:7px 13px;
        border-radius:7px;font-size:12.5px;box-shadow:0 3px 12px rgba(11,94,215,.30);
      }
      tr.row-src .price-link:hover{background:#0B3A87;text-decoration:none}
      .p-note{display:block;margin-top:4px;font-size:11.5px;font-weight:600;color:#0B5ED7}

      /* yes / no markers */
      .mk{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--ink-2)}
      .mk i{
        flex:none;width:19px;height:19px;border-radius:50%;
        display:inline-flex;align-items:center;justify-content:center;
      }
      .mk-y i{background:var(--rc,var(--ink))}
      .mk-y i::after{
        content:"";width:5px;height:9px;margin-top:-2px;
        border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg);
      }
      .mk-n{color:#9AA3AF;font-weight:500}
      .mk-n i{background:#EDF0F4}
      .mk-n i::after{content:"";width:7px;height:2px;border-radius:1px;background:#B6BDC7}
      .mk-na{color:#B6BDC7;font-weight:500;font-size:12.5px}

      .price-link{color:var(--rc,var(--ink));font-weight:700;text-decoration:none;font-size:13px;white-space:nowrap}
      .price-link:hover{text-decoration:underline}
      .ctable-note{margin-top:12px;font-size:12px;color:var(--muted)}
      .ctable-hint{display:none;font-size:11.5px;color:var(--muted);margin-top:8px}
      @media(max-width:980px){.ctable-hint{display:block}}
      .card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:18px}
      .card h3{margin:0 0 8px;font-size:15px;font-weight:700}
      .card p{margin:0;font-size:13px;color:var(--muted);line-height:1.6}
      .product-link{color:var(--accent);font-weight:700;text-decoration:underline;text-underline-offset:2px}
      .product-link:hover{opacity:.8}
      footer{background:#111827;color:#6b7280;padding:20px 0;font-size:13px}
      .footer-inner{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
      .footer-links{display:flex;gap:20px}
      .footer-links a:hover{color:white}
      .footer-disclaimer{font-size:11px;color:#374151;line-height:1.6;margin-top:8px;padding-top:8px;border-top:1px solid #1e293b}
      .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
      @media(max-width:900px){
        .compare-table{font-size:12px}
        .compare-table th,.compare-table td{padding:10px 12px}
      }
      @media(max-width:600px){
        .nav-links{display:none}
        .nav-ctas .btn-secondary{display:none}
        .hamburger{display:flex}
        .hero h1{font-size:24px}
        section{padding:20px 0}
        .compare-table{font-size:11px}
        .compare-table th,.compare-table td{padding:8px 10px}
      }
    </style>
  </head>
  <body>

    <SiteNav />

    <main>

      <section class="hero">
        <div class="wrap">
          <h1>Compare dictation solutions</h1>
          <p>Find the right tool for your workflow. Dragon, Speech Recognition Cloud, Philips SpeechLive, hardware — or combine them all.</p>
        </div>
      </section>

      <section>
        <div class="wrap">
          <div class="ctable-scroll">
            <table class="compare-table">
              <thead>
                <tr>
                  <th>Solution</th>
                  <th>Best for</th>
                  <th>Custom vocabulary</th>
                  <th>Cloud-based</th>
                  <th class="col-ai">AI document drafting</th>
                  <th>Macros / automation</th>
                  <th>Cost (AUD)</th>
                </tr>
              </thead>
              <tbody>
                <tr class="row-src" style="--rc:#0B5ED7">
                  <td class="p-cell"><a href="https://www.speechrecognition.cloud" target="_blank" rel="noopener" class="p-name">Speech Recognition Cloud</a><span class="p-badge">Most popular</span><span class="p-note">Free tier &middot; no credit card</span></td>
                  <td>Cloud-first users who want fast, accurate dictation in any Windows app — 57+ languages</td>
                  <td><span class="mk mk-y"><i></i>AI-assisted</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-y"><i></i>20+ AI commands</span></td>
                  <td><a href="https://www.speechrecognition.cloud" target="_blank" rel="noopener" class="price-link">Try free &rarr;</a></td>
                </tr>
                <tr style="--rc:#12151A">
                  <td class="p-cell"><span class="p-name">Dragon Professional 16</span></td>
                  <td>Heavy daily dictation, complex documents</td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><a href="https://www.voicerecognition.com.au/collections/dragon-professional" target="_blank" rel="noopener" class="price-link">From $994 &rarr;</a></td>
                </tr>
                <tr style="--rc:#12151A">
                  <td class="p-cell"><span class="p-name">Dragon Medical One</span></td>
                  <td>Healthcare professionals, clinical documentation</td>
                  <td><span class="mk mk-y"><i></i>Medical vocab</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><a href="https://www.voicerecognition.com.au/products/dragon-medical-one" target="_blank" rel="noopener" class="price-link">Enquire &rarr;</a></td>
                </tr>
                <tr style="--rc:#12151A">
                  <td class="p-cell"><span class="p-name">Dragon Professional Anywhere</span></td>
                  <td>Teams, hybrid work, any device</td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><a href="https://www.voicerecognition.com.au/collections/dragon-professional" target="_blank" rel="noopener" class="price-link">Enquire &rarr;</a></td>
                </tr>
                <tr style="--rc:#0B5ED7">
                  <td class="p-cell"><a href="/philips-speechlive/" class="p-name">Philips SpeechLive</a></td>
                  <td>Shared transcription workflows, author to typist</td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk-na">Enquire</span></td>
                </tr>
                <tr class="row-ai" style="--rc:#A80DF1;--rt:#FBF4FE;--rt2:#F6E9FD">
                  <td class="p-cell"><a href="/legal/" class="p-name">SpeechLive Legal AI</a><span class="p-badge">New &middot; 2026</span></td>
                  <td>Solicitors, barristers and legal executives drafting file notes, letters and case documents</td>
                  <td><span class="mk mk-y"><i></i>Legal terminology</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td class="ai-cell"><span class="mk mk-y"><i></i>Drafts into your firm&rsquo;s templates</span></td>
                  <td><span class="mk-na">Not applicable</span></td>
                  <td><a href="/legal/#register" class="price-link">Early access &rarr;</a></td>
                </tr>
                <tr class="row-ai" style="--rc:#1B3BC4;--rt:#F4F7FD;--rt2:#E9EFFA">
                  <td class="p-cell"><a href="/professional/" class="p-name">SpeechLive Professional AI</a><span class="p-badge">New &middot; 2026</span></td>
                  <td>Finance, insurance, construction and real estate — templated reports and correspondence</td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td><span class="mk mk-y"><i></i>Yes</span></td>
                  <td class="ai-cell"><span class="mk mk-y"><i></i>Drafts into your own templates</span></td>
                  <td><span class="mk-na">Not applicable</span></td>
                  <td><a href="/professional/#register" class="price-link">Early access &rarr;</a></td>
                </tr>
                <tr style="--rc:#12151A">
                  <td class="p-cell"><span class="p-name">Dictation hardware</span></td>
                  <td>Philips and OM System recorders for secure, offline capture</td>
                  <td><span class="mk-na">Not applicable</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk mk-n"><i></i>No</span></td>
                  <td><span class="mk-na">Not applicable</span></td>
                  <td><a href="https://www.voicerecognition.com.au/collections/voice-recorder" target="_blank" rel="noopener" class="price-link">Browse &rarr;</a></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="ctable-hint">Scroll the table sideways to see every column.</p>
        </div>
      </section>

      <section style="background:var(--neutral)">
        <div class="wrap">
          <h2 style="font-size:24px;margin:0 0 16px;font-weight:800">Key decision factors</h2>
          <div class="grid">
            <div class="card">
              <h3>Cloud vs local</h3>
              <p>Cloud tools (Dragon Anywhere, SpeechLive, Speech Recognition Cloud) work anywhere. Local tools (Dragon Professional desktop) offer offline capability and tighter data control.</p>
            </div>
            <div class="card">
              <h3>Custom vocabulary and macros</h3>
              <p>Dragon with custom macros can be 3x faster than typing. Philips excels at shared workflows. Speech Recognition Cloud offers 20+ AI commands without setup.</p>
            </div>
            <div class="card">
              <h3>Budget</h3>
              <p>Dragon Professional is a one-time cost (perpetual licence). Speech Recognition Cloud offers a free tier to start. Cloud subscriptions suit teams needing flexibility.</p>
            </div>
            <div class="card">
              <h3>Team workflows</h3>
              <p>Philips SpeechLive handles delegation between authors and transcriptionists. Dragon works best for individual power users who dictate heavily and automate repeatedly.</p>
            </div>
            <div class="card">
              <h3>Governance</h3>
              <p>Healthcare and government users need clear data retention, training, and compliance. Dragon Medical One and enterprise Philips include HIPAA/BAA options.</p>
            </div>
            <div class="card">
              <h3>Specialisation</h3>
              <p>Medical professionals benefit from Dragon Medical (built-in medical vocabulary). Legal teams now have <a href="/legal/" class="product-link">SpeechLive Legal AI</a>, which drafts dictation and attached files straight into your firm's templates rather than just transcribing.</p>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2 style="font-size:24px;margin:0 0 12px;font-weight:800">Common combinations</h2>
          <div class="grid">
            <div style="background:#F2F7FE;border:1px solid #DBEAFE;border-radius:12px;padding:18px">
              <h3 style="margin:0 0 8px;font-size:15px;font-weight:700">Medical professionals</h3>
              <p style="margin:0;font-size:13px;color:#374151;line-height:1.6">Dragon Medical One (primary) + Philips SpeechMike recorder (secure backup). For simpler needs, Speech Recognition Cloud with its free tier is a low-friction starting point.</p>
            </div>
            <div style="background:#F2F7FE;border:1px solid #DBEAFE;border-radius:12px;padding:18px">
              <h3 style="margin:0 0 8px;font-size:15px;font-weight:700">Legal teams</h3>
              <p style="margin:0;font-size:13px;color:#374151;line-height:1.6"><a href="/legal/" class="product-link">SpeechLive Legal AI</a> for drafting straight into your templates, plus Dragon Professional for personal power users. Speech Recognition Cloud suits fee earners who need fast, flexible dictation across devices.</p>
            </div>
            <div style="background:#F2F7FE;border:1px solid #DBEAFE;border-radius:12px;padding:18px">
              <h3 style="margin:0 0 8px;font-size:15px;font-weight:700">Single-user heavy dictators</h3>
              <p style="margin:0;font-size:13px;color:#374151;line-height:1.6">Dragon Professional 16 (local, perpetual) + custom macros for workflows. Or Speech Recognition Cloud for a cloud-first alternative with no upfront cost.</p>
            </div>
            <div style="background:#F2F7FE;border:1px solid #DBEAFE;border-radius:12px;padding:18px">
              <h3 style="margin:0 0 8px;font-size:15px;font-weight:700">Flexible / hybrid teams</h3>
              <p style="margin:0;font-size:13px;color:#374151;line-height:1.6">Dragon Professional Anywhere (cloud, all devices) + Philips SpeechMike hardware (for better audio in noisy environments).</p>
            </div>
            <div style="background:#F2F7FE;border:1px solid #DBEAFE;border-radius:12px;padding:18px">
              <h3 style="margin:0 0 8px;font-size:15px;font-weight:700">Multilingual teams</h3>
              <p style="margin:0;font-size:13px;color:#374151;line-height:1.6">Speech Recognition Cloud (57+ languages, free tier) is the natural choice where English-only Dragon is not sufficient. No training required, works instantly.</p>
            </div>
            <div style="background:#F2F7FE;border:1px solid #DBEAFE;border-radius:12px;padding:18px">
              <h3 style="margin:0 0 8px;font-size:15px;font-weight:700">Government agencies</h3>
              <p style="margin:0;font-size:13px;color:#374151;line-height:1.6">On-premises or containerised Dragon + Philips hardware for secure capture + auditable workflows with retention controls.</p>
            </div>
          </div>
        </div>
      </section>

      <section style={`background:${primaryColour};padding:36px 0`}>
        <div class="wrap">
          <h2 style="font-size:24px;margin:0 0 8px;font-weight:800;color:white">Not sure which solution is right for you?</h2>
          <p style="font-size:15px;color:#9ca3af;margin:0 0 20px;max-width:640px">Talk to our team. We have helped hundreds of Australian professionals, legal firms, and healthcare organisations choose the right combination. 25 years of deployment experience.</p>
          <a href="/#final-cta" class="btn btn-primary" style="background:var(--accent);border-color:var(--accent)">Contact Us</a>
        </div>
      </section>

    </main>

    <Footer />

  </body>
</html>
