---
import SiteNav from "../components/SiteNav.astro";
import Footer from "../components/Footer.astro";
import site from "../site.config.json";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found | {site.siteName}</title>
    <meta name="robots" content="noindex" />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&display=swap" />
    <style is:inline>
:root{--ink:#12151A;--ink-2:#2A3038;--muted:#5A6473;--line:#E5E8ED;--soft:#F7F8FA;--v:#12151A;--v-mid:#2A3038;--v-tint:#F7F8FA;--v-tint-2:#E5E8ED;--font:Figtree,system-ui,-apple-system,'Segoe UI',sans-serif;--container:1180px;--gutter:44px}
      *,*::before,*::after{box-sizing:border-box}
      body{margin:0;font-family:var(--font);font-size:15px;line-height:1.65;color:var(--ink);background:#fff;-webkit-font-smoothing:antialiased}
      main{max-width:820px;margin:0 auto;padding:56px var(--gutter) 72px}
      h1{font-size:42px;line-height:1.06;letter-spacing:-.038em;font-weight:800;margin:0 0 18px}
      h2{font-size:24px;line-height:1.2;letter-spacing:-.03em;font-weight:800;margin:34px 0 10px}
      h3{font-size:17px;font-weight:700;letter-spacing:-.015em;margin:24px 0 8px}
      p,li{color:var(--ink-2)}
      p{margin:0 0 14px}
      ul,ol{margin:0 0 16px;padding-left:22px}
      li{margin-bottom:7px}
      a{color:var(--ink);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px}
      a:hover{color:var(--v-mid)}
      hr{border:none;border-top:1px solid var(--line);margin:30px 0}
      @media(max-width:900px){ h1{font-size:32px} main{padding:38px 24px 54px} }
    </style>
  </head>
  <body style="margin:0;font-family:system-ui,sans-serif;background:#fff;color:#111827;display:flex;align-items:center;justify-content:center;min-height:100vh">
    <SiteNav />
    <main>
    <div style="text-align:center;padding:48px 24px">
      <div style="font-size:78px;font-weight:800;letter-spacing:-.05em;color:var(--ink)">404</div>
      <h1 style="font-size:24px;margin:0 0 12px">Page not found</h1>
      <p style="color:#6b7280;margin:0 0 24px">The page you are looking for does not exist or has moved.</p>
      <a href="/" style="background:var(--ink);color:#fff;border-radius:9px;padding:13px 26px;font-weight:700;font-size:15px;text-decoration:none">Back to home</a>
    </div>
    </main>
    <Footer />
  </body>
</html>
