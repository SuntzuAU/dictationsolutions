              const cardClass = `compare-card c4${isSRC ? ' src-highlight' : ''}${vertical ? ' v-' + vertical : ''}`;
              return (
                <div class={cardClass}>
                  <div class={`product-badge${isSRC ? ' badge-blue' : ''}${vertical ? ' badge-' + vertical : ''}`}>{p.badge}</div>
                  <h3 class="compare-title">
                    <a href={href} class="compare-link" target={isSRC ? '_blank' : undefined} rel={isSRC ? 'noopener' : undefined}>{p.title}</a>
                  </h3>
                  <div class="compare-for">{p.bestFor}</div>
                  <div class={`compare-price${isSRC ? ' price-blue' : ''}${vertical ? ' price-' + vertical : ''}`}>{p.price}</div>
                  <div class="compare-pricenote">{p.priceNote}</div>
                  {isSRC && <div style="font-size:12px;color:#2563eb;font-weight:600;margin-bottom:12px">Free tier available &bull; 57 languages</div>}
                  <a href={href} class="compare-btn" target={isSRC ? '_blank' : undefined} rel={isSRC ? 'noopener' : undefined} aria-label={isSRC ? 'Try speech-to-text software free' : `View ${p.title} details`}>{p.ctaText ? p.ctaText + ' \u2192' : isSRC ? 'Try speech-to-text software free \u2192' : 'View details \u2192'}</a>
